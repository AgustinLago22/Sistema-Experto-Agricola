# Copiar como .env (que está en .gitignore) y completar. Ver B.13.
# NO generar una clave nueva: tiene que ser la que n8n guardó en
# /home/node/.n8n/config en su primer arranque, o las credenciales
# existentes quedan irrecuperables.
N8N_ENCRYPTION_KEY=

# Token del bot de Telegram, para WF6 (ver 13.13.6). Se saca de BotFather:
# /mybots -> el bot -> API Token. Sin comillas ni espacios.
TELEGRAM_BOT_TOKEN=
