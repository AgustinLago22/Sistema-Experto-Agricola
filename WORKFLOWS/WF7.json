      "parameters": {
        "jsCode": "// ============================================================\n// VALIDAR ARRANQUE — WF7 · contrato de telemetría v1, sección 1\n// Escrito el 19/10/2026 (sesión 17).\n// ------------------------------------------------------------\n// La placa pide un arranque_id UNA vez por encendido, antes de mandar lecturas.\n// Este nodo revisa el pedido; el número lo da la base (fn_registrar_arranque),\n// que es la única que puede garantizar que no se repita (regla de 16.25).\n// ============================================================\nconst VERSION_CONTRATO = 1;\nconst MAC_RE = /^[0-9A-F]{2}(:[0-9A-F]{2}){5}$/i;\nconst FW_MAX = 20; // el largo de la columna en arranque_dispositivo\n\nconst crudo = $('Webhook').first().json.body;\nconst esObjeto = crudo !== null && typeof crudo === 'object' && !Array.isArray(crudo);\nconst b = esObjeto ? crudo : {};\nconst errores = [];\nconst tiene = (k) => Object.prototype.hasOwnProperty.call(b, k);\nconst mostrar = (x) => JSON.stringify(x) ?? String(x);\n\nif (!esObjeto) {\n  errores.push('cuerpo: tiene que ser un objeto JSON');\n} else if (tiene('v') && b.v !== VERSION_CONTRATO) {\n  errores.push(`v: versión ${mostrar(b.v)} desconocida; este servidor entiende la ${VERSION_CONTRATO}`);\n} else {\n  if (!tiene('v')) errores.push('v: falta');\n\n  if (!tiene('dispositivo_mac')) errores.push('dispositivo_mac: falta');\n  else if (typeof b.dispositivo_mac !== 'string' || !MAC_RE.test(b.dispositivo_mac.trim()))\n    errores.push(`dispositivo_mac: ${mostrar(b.dispositivo_mac)} no tiene el formato AA:BB:CC:DD:EE:FF`);\n\n  if (!tiene('fw')) errores.push('fw: falta');\n  else if (typeof b.fw !== 'string' || b.fw.trim() === '' || b.fw.trim().length > FW_MAX)\n    errores.push(`fw: ${mostrar(b.fw)} tiene que ser texto de 1 a ${FW_MAX} caracteres`);\n}\n\nconst pedidoOk = errores.length === 0;\n\nreturn [{\n  json: {\n    pedido_ok: pedidoOk,\n    errores,\n    arranque: pedidoOk\n      ? { dispositivo_mac: b.dispositivo_mac.trim().toUpperCase(), fw: b.fw.trim() }\n      : null,\n  },\n}];\n"
      },
      "id": "f5c335e0-573f-44e3-a425-b3b64c45b021",
