    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF4 · Armar pedido (Code, una vez por cada ítem)\n// El mismo pedido que /diagnostico de WF6, con origen 'proactivo' (16.43).\n// Si la foto no bajó, no se pide nada: el próximo turno la vuelve a intentar.\n\nconst MINIMO_BASE64 = 1000;   // menos que eso no es una foto (como WF3 y WF6)\n\nconst c = $('Fotos para analizar').item.json;\nlet foto = $json.foto_base64;\nif (foto && typeof foto === 'object' && 'value' in foto) foto = foto.value;\nconst listo = typeof c.cultivo_id === 'string' && typeof foto === 'string' && foto.trim().length >= MINIMO_BASE64;\n\nconst fecha = iso => new Date(iso).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires',\n  day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\nconst lectura = c.ultima_lectura_fecha ? `la última lectura es del ${fecha(c.ultima_lectura_fecha)}`\n  : 'no hay lecturas: los valores van sin dato';\n\nreturn { json: {\n  listo,\n  cultivo_id: c.cultivo_id ?? null,\n  cuerpo: !listo ? null : {\n    cultivo_id: c.cultivo_id, etapas_especie_id: c.etapas_especie_id, planta: c.planta, etapa: c.etapa,\n    mac_address: c.dispositivo_mac, humedad: c.humedad, ph: c.ph, n: c.n, p: c.p, k: c.k,\n    umbrales: { humedad: { min: c.humedad_min, max: c.humedad_max }, ph: { min: c.ph_min, max: c.ph_max },\n                n_ideal: c.ideal_n, p_ideal: c.ideal_p, k_ideal: c.ideal_k },\n    estado: 'REVISIÓN DE RUTINA',\n    observaciones: [\n      'Revisión de rutina de la foto (WF4), sin una alerta que la pida.',\n      `La foto es del ${fecha(c.ultima_foto_fecha)}; ${lectura}.`,\n    ],\n    path_foto_evento: c.ultima_foto_path,\n    origen: 'proactivo',\n    foto_base64: foto.trim(),\n  },\n} };\n"
      },
      "type": "n8n-nodes-base.code",
