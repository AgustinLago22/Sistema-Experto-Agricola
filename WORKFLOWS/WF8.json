      "parameters": {
        "jsCode": "// ============================================================\n// VALIDAR ACUSE — WF8 · 16.63\n// Escrito el 09/11/2026 (sesión 22).\n// ------------------------------------------------------------\n// La placa avisa cómo terminó una orden: \"ejecutado\" o \"error\". Este nodo\n// revisa el pedido; si la orden es de esa placa, si estaba entregada y si el\n// acuse es un reintento, lo decide la base (fn_acusar_orden). Repetir el\n// mismo acuse es seguro: la base responde \"duplicado\" y no cambia nada.\n// ============================================================\nconst VERSION_CONTRATO = 1;\nconst MAC_RE = /^[0-9A-F]{2}(:[0-9A-F]{2}){5}$/i;\nconst RESULTADOS = ['ejecutado', 'error'];\n\nconst crudo = $('Webhook Acuse').first().json.body;\nconst esObjeto = crudo !== null && typeof crudo === 'object' && !Array.isArray(crudo);\nconst b = esObjeto ? crudo : {};\nconst errores = [];\nconst tiene = (k) => Object.prototype.hasOwnProperty.call(b, k);\nconst esEntero = (x) => typeof x === 'number' && Number.isSafeInteger(x);\nconst mostrar = (x) => JSON.stringify(x) ?? String(x);\n\nif (!esObjeto) {\n  errores.push('cuerpo: tiene que ser un objeto JSON');\n} else if (tiene('v') && b.v !== VERSION_CONTRATO) {\n  errores.push(`v: versión ${mostrar(b.v)} desconocida; este servidor entiende la ${VERSION_CONTRATO}`);\n} else {\n  if (!tiene('v')) errores.push('v: falta');\n\n  if (!tiene('dispositivo_mac')) errores.push('dispositivo_mac: falta');\n  else if (typeof b.dispositivo_mac !== 'string' || !MAC_RE.test(b.dispositivo_mac.trim()))\n    errores.push(`dispositivo_mac: ${mostrar(b.dispositivo_mac)} no tiene el formato AA:BB:CC:DD:EE:FF`);\n\n  if (!tiene('arranque_id')) errores.push('arranque_id: falta');\n  else if (!esEntero(b.arranque_id) || b.arranque_id < 1)\n    errores.push(`arranque_id: ${mostrar(b.arranque_id)} no es un entero positivo`);\n\n  if (!tiene('comando_id')) errores.push('comando_id: falta');\n  else if (!esEntero(b.comando_id) || b.comando_id < 1)\n    errores.push(`comando_id: ${mostrar(b.comando_id)} no es un entero positivo`);\n\n  if (!tiene('resultado')) errores.push('resultado: falta');\n  else if (!RESULTADOS.includes(b.resultado))\n    errores.push(`resultado: ${mostrar(b.resultado)} tiene que ser \"ejecutado\" o \"error\"`);\n}\n\nconst acuseOk = errores.length === 0;\n\nreturn [{\n  json: {\n    acuse_ok: acuseOk,\n    errores,\n    acuse: acuseOk\n      ? {\n          dispositivo_mac: b.dispositivo_mac.trim().toUpperCase(),\n          arranque_id: b.arranque_id,\n          comando_id: b.comando_id,\n          resultado: b.resultado,\n        }\n      : null,\n  },\n}];\n"
      },
