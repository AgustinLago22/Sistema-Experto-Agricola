      "parameters": {
        "jsCode": "// ============================================================\n// VALIDAR PEDIDO DE ÓRDENES — WF8 · 16.63\n// Escrito el 09/11/2026 (sesión 22).\n// ------------------------------------------------------------\n// La placa pregunta si tiene órdenes. Este nodo revisa el pedido; qué órdenes\n// le tocan, y que cada una se entregue una sola vez, lo decide la base\n// (fn_tomar_ordenes). La Secret key no sale de n8n: la placa solo tiene su\n// X-Device-Key, la misma del arranque y de las lecturas.\n// ============================================================\nconst VERSION_CONTRATO = 1;\nconst MAC_RE = /^[0-9A-F]{2}(:[0-9A-F]{2}){5}$/i;\n\nconst crudo = $('Webhook Ordenes').first().json.body;\nconst esObjeto = crudo !== null && typeof crudo === 'object' && !Array.isArray(crudo);\nconst b = esObjeto ? crudo : {};\nconst errores = [];\nconst tiene = (k) => Object.prototype.hasOwnProperty.call(b, k);\nconst esEntero = (x) => typeof x === 'number' && Number.isSafeInteger(x);\nconst mostrar = (x) => JSON.stringify(x) ?? String(x);\n\nif (!esObjeto) {\n  errores.push('cuerpo: tiene que ser un objeto JSON');\n} else if (tiene('v') && b.v !== VERSION_CONTRATO) {\n  errores.push(`v: versión ${mostrar(b.v)} desconocida; este servidor entiende la ${VERSION_CONTRATO}`);\n} else {\n  if (!tiene('v')) errores.push('v: falta');\n\n  if (!tiene('dispositivo_mac')) errores.push('dispositivo_mac: falta');\n  else if (typeof b.dispositivo_mac !== 'string' || !MAC_RE.test(b.dispositivo_mac.trim()))\n    errores.push(`dispositivo_mac: ${mostrar(b.dispositivo_mac)} no tiene el formato AA:BB:CC:DD:EE:FF`);\n\n  if (!tiene('arranque_id')) errores.push('arranque_id: falta');\n  else if (!esEntero(b.arranque_id) || b.arranque_id < 1)\n    errores.push(`arranque_id: ${mostrar(b.arranque_id)} no es un entero positivo`);\n}\n\nconst pedidoOk = errores.length === 0;\n\nreturn [{\n  json: {\n    pedido_ok: pedidoOk,\n    errores,\n    pedido: pedidoOk\n      ? { dispositivo_mac: b.dispositivo_mac.trim().toUpperCase(), arranque_id: b.arranque_id }\n      : null,\n  },\n}];\n"
      },
